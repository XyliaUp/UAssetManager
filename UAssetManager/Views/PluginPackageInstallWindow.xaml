<Window x:Class="UAssetManager.Views.PluginPackageInstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource PluginInstaller.Title}" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=RepositoryUrl}">
    <StackPanel Margin="18">
        <Label Target="{Binding ElementName=RepositoryUrl}" Content="{DynamicResource PluginInstaller.RepositoryUrl}"
               FontWeight="SemiBold" Padding="0,0,0,5"/>
        <DockPanel>
            <Button x:Name="FindButton" DockPanel.Dock="Right" Content="{DynamicResource PluginInstaller.Find}"
                    MinWidth="82" Padding="10,4" Margin="8,0,0,0" Click="Find_Click"/>
            <TextBox x:Name="RepositoryUrl" Padding="6,4" VerticalContentAlignment="Center"
                     AutomationProperties.Name="{DynamicResource PluginInstaller.RepositoryUrl}"/>
        </DockPanel>
        <StackPanel x:Name="ReleaseDetails" Visibility="Collapsed" Margin="0,12,0,0">
            <TextBlock x:Name="ReleaseVersion" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="ReleaseFile" TextWrapping="Wrap" Margin="0,3,0,0"/>
        </StackPanel>
        <ScrollViewer x:Name="StatusPanel" Visibility="Collapsed" MaxHeight="100"
                      VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </ScrollViewer>
        <ProgressBar x:Name="DownloadProgress" Visibility="Collapsed" Height="4" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="InstallButton" Content="{DynamicResource PluginInstaller.Install}" MinWidth="82"
                    Padding="10,4" Margin="0,0,8,0" Click="Install_Click"/>
            <Button x:Name="CloseButton" Content="{DynamicResource Text.Close}" IsCancel="True"
                    MinWidth="82" Padding="10,4"/>
        </StackPanel>
    </StackPanel>
</Window>
